<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.albertokitala.gestaoescolar.controller.ControllerMenuPrincipal">
   <children>
      <VBox prefHeight="710.0" prefWidth="1240.0" spacing="20.0" style="-fx-background-color: #E8EBF0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="24.0" left="20.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <VBox prefHeight="100.0" prefWidth="252.0">
                     <children>
                        <Label prefHeight="30.0" prefWidth="156.0" style="-fx-text-fill: #1A365D;" text="Alunos-Gestão">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label prefHeight="17.0" prefWidth="135.0" text="de Alunos">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label prefHeight="17.0" prefWidth="245.0" style="-fx-text-fill: #4A5568;" text="Gerencie os alunos Cadastrados no Sistema" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="665.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12;">
                     <children>
                        <StackPane prefHeight="150.0" prefWidth="200.0">
                           <children>
                              <TextField promptText="Buscar Alunos ..." />
                              <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@icons/search.png" />
                                 </image>
                                 <StackPane.margin>
                                    <Insets left="170.0" />
                                 </StackPane.margin>
                              </ImageView>
                           </children>
                        </StackPane>
                        <ComboBox prefHeight="25.0" prefWidth="157.0" promptText="Todas as Turmas" />
                        <ComboBox prefHeight="25.0" prefWidth="111.0" promptText="Status" />
                        <Button fx:id="btnNovoAluno" mnemonicParsing="false" onAction="#OnActionCadastrarNovoAluno" prefHeight="33.0" prefWidth="130.0" style="-fx-background-color: #0a2a4a; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" text="+ Novo Aluno" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 15;">
               <children>
                  <TableView prefHeight="479.0" prefWidth="1061.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn prefWidth="20.0" />
                      <TableColumn prefWidth="50.0" text="Foto" />
                        <TableColumn prefWidth="140.0" text="Nome" />
                        <TableColumn prefWidth="90.0" text="Nº B.I" />
                        <TableColumn prefWidth="60.0" text="Turma" />
                        <TableColumn prefWidth="180.0" text="Email" />
                        <TableColumn text="Status" />
                        <TableColumn prefWidth="75.0" text="Ações" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
